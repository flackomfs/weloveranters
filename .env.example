# Firebase client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase server-side verification
# Use the values from your Firebase service account JSON.
# Keep the private key as a multi-line value in Vercel; if needed, escape newlines as \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ADMIN_UIDS=

# Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CRON_SECRET=

# Web Push (generate once with `npx web-push generate-vapid-keys`)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://weloveranters.me

# Gemini server-side support bot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# App config
NEXT_PUBLIC_APP_URL=http://localhost:3000
