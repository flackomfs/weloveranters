# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/feed
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/feed

# Existing database IDs or Clerk user IDs for site admins
ADMIN_UIDS=

# Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CRON_SECRET=

# Web Push (generate once with `npx web-push generate-vapid-keys`)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://weloveranters.me

# Gemini server-side support bot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# App config
NEXT_PUBLIC_APP_URL=http://localhost:3000
